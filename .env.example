# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/careconnect

# Client Origin
CLIENT_URL=http://localhost:5173

# Security & Secrets
JWT_SECRET=super_secret_jwt_key_careconnect_dev_2026
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_careconnect_dev_2026
COOKIE_SECRET=super_secret_cookie_parser_careconnect_dev_2026

# AI Engine (OpenAI sk-... or Groq gsk_... key; fallback engine built-in if empty)
OPENAI_API_KEY=
# Optional overrides: AI_BASE_URL, AI_MODEL (Groq default: qwen/qwen3.8-27b, OpenAI default: gpt-3.5-turbo)
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=qwen/qwen3.8-27b

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
